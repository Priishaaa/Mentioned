# Copy to .env (in this folder) and fill in the keys you have.
# With no keys at all the server runs in demo mode (simulated checks, sample report).

# ── Free setup ───────────────────────────────────────────────────────────────
# Gemini: free key from https://aistudio.google.com (Get API key).
# Measures Gemini AND does the analysis (writing questions, reading answers, writing fixes).
GEMINI_API_KEY=

# ── Paid (optional, switch on automatically when set) ─────────────────────────
# ANTHROPIC_API_KEY=    # measures Claude, and takes over the analysis from Gemini
# OPENAI_API_KEY=       # measures ChatGPT

# ── Optional settings ─────────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-3.5-flash          # the Gemini model being measured
# ANALYSIS_MODEL=gemini-3.5-flash        # model doing the analysis (claude-opus-5-5 with an Anthropic key)
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5
# PORT=8787
# RATE_LIMIT_PER_HOUR=5                  # checks per visitor IP per hour
# CONCURRENCY=2                          # parallel calls within a check (free tiers limit requests per minute)
# READ_BATCH=10                          # answers read per analysis call
# DATA_DIR=/var/lib/mentioned            # where finished reports are saved (default: server/data)
# DEMO_MODE=1                            # force demo mode even with keys set

# ── Hosting (Render) ─────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://your-site.vercel.app   # sites allowed to call the API from a browser
# DAILY_CHECK_LIMIT=2                            # checks per day for the whole site
# UPSTASH_REDIS_REST_URL=                        # free Upstash Redis, so saved reports survive restarts
# UPSTASH_REDIS_REST_TOKEN=
# (In the frontend's settings on Vercel: VITE_API_URL=https://your-api.onrender.com)
